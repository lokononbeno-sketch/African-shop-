
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#171717">
  <title>African Shop | Le commerce africain</title>
  <style>
    :root {
      --orange: #f47721;
      --black: #171717;
      --cream: #fff8f1;
      --muted: #777;
    }

    * { box-sizing: border-box; }

    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #f7f7f7;
      color: var(--black);
    }

    header {
      background: var(--black);
      color: white;
      padding: 18px 16px;
    }

    .brand {
      font-size: 25px;
      font-weight: 900;
      letter-spacing: -1px;
    }

    .brand span { color: var(--orange); }

    .tagline {
      color: #ddd;
      font-size: 12px;
      margin-top: 5px;
    }

    .search {
      display: flex;
      gap: 8px;
      margin-top: 17px;
    }

    input, select, button {
      font: inherit;
    }

    .search input {
      width: 100%;
      min-width: 0;
      padding: 12px;
      border: 0;
      border-radius: 9px;
    }

    button {
      cursor: pointer;
      border: 0;
      border-radius: 9px;
      padding: 11px 14px;
      font-weight: bold;
    }

    .orange {
      background: var(--orange);
      color: #171717;
    }

    .hero {
      margin: 16px;
      padding: 24px 20px;
      border-radius: 18px;
      color: white;
      background:
        radial-gradient(circle at top right, #81401c, transparent 50%),
        #202020;
    }

    .hero small {
      color: var(--orange);
      font-weight: bold;
      letter-spacing: 2px;
    }

    .hero h1 {
      font-size: 29px;
      line-height: 1.15;
      margin: 12px 0;
    }

    .hero p {
      color: #e5e5e5;
      line-height: 1.5;
      font-size: 14px;
    }

    main { padding: 0 16px 90px; }

    h2 { font-size: 20px; margin: 24px 0 14px; }

    .categories {
      display: flex;
      gap: 9px;
      overflow-x: auto;
      padding-bottom: 5px;
    }

    .category {
      background: white;
      border: 1px solid #eee;
      white-space: nowrap;
    }

    .category.active {
      background: var(--orange);
      border-color: var(--orange);
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }

    .product {
      overflow: hidden;
      background: white;
      border-radius: 13px;
      border: 1px solid #eee;
    }

    .product img {
      display: block;
      width: 100%;
      height: 135px;
      object-fit: cover;
      background: #eee;
    }

    .product-info { padding: 11px; }

    .product h3 {
      font-size: 14px;
      margin: 0 0 8px;
    }

    .price {
      color: #c4530b;
      font-size: 16px;
      font-weight: 900;
    }

    .seller {
      color: var(--muted);
      font-size: 11px;
      margin: 6px 0 10px;
    }

    .product button { width: 100%; font-size: 12px; }

    .panel {
      display: none;
      background: white;
      border-radius: 13px;
      padding: 16px;
      margin-top: 18px;
    }

    .panel.show { display: block; }

    .cart-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      padding: 12px 0;
      border-bottom: 1px solid #eee;
      font-size: 13px;
    }

    .empty {
      color: var(--muted);
      font-size: 14px;
    }

    .bottom-nav {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      display: flex;
      justify-content: space-around;
      background: white;
      border-top: 1px solid #ddd;
      padding: 10px 4px;
      padding-bottom: max(10px, env(safe-area-inset-bottom));
    }

    .bottom-nav button {
      background: white;
      font-size: 11px;
      padding: 7px 5px;
    }

    .bottom-nav button.active { color: #d95c0b; }

    .notice {
      font-size: 12px;
      color: var(--muted);
      line-height: 1.5;
    }

    .field {
      display: block;
      width: 100%;
      padding: 12px;
      margin: 10px 0;
      border: 1px solid #ddd;
      border-radius: 8px;
    }

    footer {
      text-align: center;
      color: var(--muted);
      font-size: 11px;
      padding: 20px 10px;
    }
  </style>
</head>
<body>

<header>
  <div class="brand">AFRICAN <span>SHOP</span></div>
  <div class="tagline">Le commerce africain, à portée de main.</div>

  <div class="search">
    <input id="search" type="search"
      placeholder="Rechercher un produit..."
      aria-label="Rechercher un produit">
    <button class="orange" onclick="renderProducts()">Chercher</button>
  </div>
</header>

<section class="hero">
  <small>BIENVENUE CHEZ AFRICAN SHOP</small>
  <h1>Découvre.<br>Achète. Vends.</h1>
  <p>Retrouve des produits et des commerçants près de chez toi.</p>
  <button class="orange" onclick="showPage('products')">
    Explorer la boutique →
  </button>
</section>

<main>
  <section id="productsPage">
    <h2>Nos catégories</h2>
    <div class="categories" id="categories"></div>

    <h2>Produits à découvrir</h2>
    <div class="grid" id="products"></div>
  </section>

  <section id="cartPage" class="panel">
    <h2>🛒 Mon panier</h2>
    <div id="cartItems"></div>
    <h3 id="total">Total : 0 FCFA</h3>
    <button class="orange" onclick="checkout()">
      Continuer la commande
    </button>
    <p class="notice">
      Démonstration uniquement : aucun paiement réel n'est effectué.
    </p>
  </section>

  <section id="sellerPage" class="panel">
    <h2>🏪 Espace vendeur</h2>
    <p class="notice">
      Voici un aperçu du formulaire de publication.
      Les produits ajoutés ici restent dans cette démonstration locale.
    </p>
    <input class="field" id="newName" placeholder="Nom du produit">
    <input class="field" id="newPrice" type="number"
      min="1" placeholder="Prix en FCFA">
    <select class="field" id="newCategory">
      <option>Mode</option>
      <option>Électronique</option>
      <option>Maison</option>
      <option>Beauté</option>
      <option>Alimentation</option>
    </select>
    <button class="orange" onclick="addProduct()">
      Ajouter le produit
    </button>
  </section>

  <section id="ordersPage" class="panel">
    <h2>📦 Mes commandes</h2>
    <p class="empty">Tes commandes de démonstration apparaîtront ici.</p>
  </section>

  <footer>
    African Shop © 2026 · Pensé pour le commerce africain 🇧🇯
  </footer>
</main>

<nav class="bottom-nav">
  <button class="active" onclick="showPage('products')">🏠<br>Accueil</button>
  <button onclick="showPage('products')">🔎<br>Produits</button>
  <button onclick="showPage('cart')">🛒 <span id="cartCount">0</span><br>Panier</button>
  <button onclick="showPage('orders')">📦<br>Commandes</button>
  <button onclick="showPage('seller')">🏪<br>Vendre</button>
</nav>

<script>
  const productsData = [
    {
      id: 1, name: "Sac artisanal",
      price: 6500, category: "Mode",
      seller: "Créations du Bénin",
      image: "https://images.unsplash.com/photo-1590874103328-eac38a683ce7?auto=format&fit=crop&w=500&q=65"
    },
    {
      id: 2, name: "Écouteurs sans fil",
      price: 8500, category: "Électronique",
      seller: "Tech Cotonou",
      image: "https://images.unsplash.com/photo-1505740420928-5e560c06d30e?auto=format&fit=crop&w=500&q=65"
    },
    {
      id: 3, name: "Décoration artisanale",
      price: 5000, category: "Maison",
      seller: "Art et Tradition",
      image: "https://images.unsplash.com/photo-1490312278390-ab64016e0aa9?auto=format&fit=crop&w=500&q=65"
    },
    {
      id: 4, name: "Soin naturel",
      price: 3000, category: "Beauté",
      seller: "Beauté Naturelle",
      image: "https://images.unsplash.com/photo-1608248543803-ba4f8c70ae0b?auto=format&fit=crop&w=500&q=65"
    }
  ];

  let cart = [];
  let selectedCategory = "Tout";
  let nextId = 5;

  const money = n =>
    n.toLocaleString("fr-FR") + " FCFA";

  function renderCategories() {
    const names = ["Tout", ...new Set(
      productsData.map(p => p.category)
    )];

    document.getElementById("categories").innerHTML =
      names.map(name => `
        <button class="category ${
          selectedCategory === name ? "active" : ""
        }" onclick="selectCategory('${name}')">
          ${name}
        </button>
      `).join("");
  }

  function selectCategory(name) {
    selectedCategory = name;
    renderCategories();
    renderProducts();
  }

  function renderProducts() {
    const query = document.getElementById("search")
      .value.trim().toLowerCase();

    const filtered = productsData.filter(p =>
      (selectedCategory === "Tout" ||
       p.category === selectedCategory) &&
      p.name.toLowerCase().includes(query)
    );

    document.getElementById("products").innerHTML =
      filtered.length ? filtered.map(p => `
        <article class="product">
          <img src="${p.image}" alt="${p.name}" loading="lazy">
          <div class="product-info">
            <h3>${p.name}</h3>
            <div class="price">${money(p.price)}</div>
            <div class="seller">${p.seller}</div>
            <button class="orange" onclick="addToCart(${p.id})">
              Ajouter au panier
            </button>
          </div>
        </article>
      `).join("") :
      '<p>Aucun produit trouvé.</p>';
  }

  function addToCart(id) {
    const product = productsData.find(p => p.id === id);
    if (!product) return;

    const existing = cart.find(p => p.id === id);
    if (existing) existing.quantity++;
    else cart.push({ ...product, quantity: 1 });

    renderCart();
    alert("Produit ajouté au panier !");
  }

  function renderCart() {
    document.getElementById("cartCount").textContent =
      cart.reduce((sum, p) => sum + p.quantity, 0);

    document.getElementById("cartItems").innerHTML =
      cart.length ? cart.map(p => `
        <div class="cart-row">
          <span>${p.name} × ${p.quantity}</span>
          <strong>${money(p.price * p.quantity)}</strong>
          <button onclick="removeFromCart(${p.id})">✕</button>
        </div>
      `).join("") : '<p class="empty">Ton panier est vide.</p>';

    const total = cart.reduce(
      (sum, p) => sum + p.price * p.quantity, 0
    );
    document.getElementById("total").textContent =
      "Total : " + money(total);
  }

  function removeFromCart(id) {
    cart = cart.filter(p => p.id !== id);
    renderCart();
  }

  function showPage(page) {
    ["productsPage", "cartPage", "sellerPage", "ordersPage"]
      .forEach(id => {
        document.getElementById(id).classList.remove("show");
      });

    document.getElementById("productsPage").style.display =
      page === "products" ? "block" : "none";

    if (page !== "products") {
      document.getElementById(page + "Page").classList.add("show");
    }

    document.querySelectorAll(".bottom-nav button")
      .forEach(btn => btn.classList.remove("active"));

    const index = {
      products: 0, cart: 2, orders: 3, seller: 4
    }[page] ?? 0;

    document.querySelectorAll(".bottom-nav button")[index]
      .classList.add("active");

    window.scrollTo({ top: 0, behavior: "smooth" });
  }

  function addProduct() {
    const name = document.getElementById("newName")
      .value.trim();
    const price = Number(
      document.getElementById("newPrice").value
    );
    const category = document.getElementById("newCategory").value;

    if (!name || !Number.isFinite(price) || price <= 0) {
      alert("Entre un nom et un prix valide.");
      return;
    }

    productsData.push({
      id: nextId++,
      name,
      price,
      category,
      seller: "Ma boutique",
      image: ""
    });

    // Image de remplacement pour les nouveaux produits.
    productsData[productsData.length - 1].image =
      "https://placehold.co/500x350/F47721/171717?text=African+Shop";

    document.getElementById("newName").value = "";
    document.getElementById("newPrice").value = "";

    renderCategories();
    renderProducts();
    alert("Produit ajouté à la démonstration !");
    showPage("products");
  }

  function checkout() {
    if (!cart.length) {
      alert("Ton panier est vide.");
      return;
    }

    alert(
      "La commande est prête pour la prochaine étape. " +
      "Le paiement réel n'est pas encore activé."
    );
  }

  document.getElementById("search")
    .addEventListener("input", renderProducts);

  renderCategories();
  renderProducts();
  renderCart();
</script>
</body>
</html>
